<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>bridge</AssemblyName>
    <!-- Keep first-run build noise from dotnet off the user's terminal; we only care about our own stderr. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../vendor/parser/src/FortniteReplayReader/FortniteReplayReader.csproj" />
  </ItemGroup>

</Project>
